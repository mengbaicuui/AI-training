                    220.0,
                    466.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(3) 对营业收入及毛利率按月度、产品、客户等实施分析程序，识别是否存在重大或异常波动，并查明波动原因；",
            "block_bbox": [
                174,
                480,
                1065,
                559
            ],
            "block_id": 5,
            "block_order": 5,
            "group_id": 5,
            "global_block_id": 442,
