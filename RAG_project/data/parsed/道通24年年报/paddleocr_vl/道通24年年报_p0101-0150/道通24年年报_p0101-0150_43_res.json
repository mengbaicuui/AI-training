                    174.0,
                    419.0
                ]
            ]
        },
        {
            "block_label": "text",
            "block_content": "(2) 检查销售合同，了解主要合同条款或条件，评价收入确认方法是否适当；",
            "block_bbox": [
                220,
                434,
                1028,
                466
            ],
            "block_id": 4,
            "block_order": 4,
            "group_id": 4,
            "global_block_id": 441,
